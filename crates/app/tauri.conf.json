{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klubblisten Studio",
  "version": "0.1.0",
  "identifier": "no.klubblisten.studio",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Klubblisten Studio Suite",
        "width": 1440,
        "height": 940,
        "minWidth": 1024,
        "minHeight": 680,
        "backgroundColor": "#0a0a0c",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Music",
    "shortDescription": "Studio-mikser for Klubblisten",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    }
  }
}